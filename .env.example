# Perplexity API Key — get yours at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backend host/port (optional, defaults shown)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (Next.js) — must match the backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
